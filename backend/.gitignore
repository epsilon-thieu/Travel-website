# ==============================
# 1. Thư mục chứa thư viện (Quan trọng nhất)
# ==============================
# Không bao giờ push thư mục này lên Git vì nó rất nặng và server có thể tự tải lại được bằng lệnh npm install
node_modules/

# ==============================
# 2. File cấu hình và Bảo mật (Cực kỳ quan trọng)
# ==============================
# Bắt buộc phải bỏ qua file .env để không bị lộ mật khẩu Database, Secret Key lên Github
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================
# 3. File Build của TypeScript
# ==============================
# Khi chạy thật, code TS sẽ được dịch ra JS nằm ở các thư mục này, không cần đưa lên Git
dist/
build/
out/

# ==============================
# 4. Prisma 
# ==============================
# Bỏ qua các file database local (nếu sau này bạn dùng SQLite để test)
prisma/*.db
prisma/*.db-journal

# ==============================
# 5. File Log (Ghi chú lỗi)
# ==============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================
# 6. File hệ điều hành & Trình soạn thảo
# ==============================
# Sinh ra bởi macOS hoặc Windows
.DS_Store
Thumbs.db
# Sinh ra bởi VS Code hoặc các IDE khác
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln