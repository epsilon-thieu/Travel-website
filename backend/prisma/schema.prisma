generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  googleId     String?   @unique
  facebookId     String?   @unique
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  phoneNumber  String?   @map("phone_number") @db.VarChar(15)
  avatarUrl    String?   @map("avatar_url")
  authProvider String?   @default("local") @map("auth_provider") @db.VarChar(20)
  role         String?   @default("user") @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings     Booking[]
  reviews      Review[]

  @@map("users")
}

model Tour {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String    @db.VarChar(255)
  description       String?
  tourType          String    @map("tour_type") @db.VarChar(50)
  price             Decimal   @db.Decimal(12, 2)
  discountPrice     Decimal?  @map("discount_price") @db.Decimal(12, 2)
  duration          String?   @db.VarChar(50)
  departureLocation String?   @map("departure_location") @db.VarChar(100)
  destination       String?   @db.VarChar(100)
  startDate         DateTime  @map("start_date") @db.Date
  availableSeats    Int       @map("available_seats")
  images            String[]
  isTrending        Boolean?  @default(false) @map("is_trending")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings          Booking[]
  reviews           Review[]

  @@map("tours")
}

model Booking {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  tourId         String?   @map("tour_id") @db.Uuid
  totalPrice     Decimal   @map("total_price") @db.Decimal(12, 2)
  numberOfPeople Int       @map("number_of_people")
  status         String?   @default("pending") @db.VarChar(20)
  contactEmail   String    @map("contact_email") @db.VarChar(255)
  contactPhone   String?   @map("contact_phone") @db.VarChar(15)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tour           Tour?     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@map("bookings")
}

model Payment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String?   @map("booking_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @map("payment_method") @db.VarChar(50)
  transactionId String?   @map("transaction_id") @db.VarChar(255)
  paymentStatus String?   @default("pending") @map("payment_status") @db.VarChar(20)
  paymentDate   DateTime? @map("payment_date") @db.Timestamptz(6)
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  tourId    String?   @map("tour_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tour      Tour?     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@map("reviews")
}
